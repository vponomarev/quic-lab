<Window x:Class="QuicLab.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="QUIC Lab · Windows" Width="820" Height="620" MinWidth="620" MinHeight="440" Background="#F3F6F8"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="QUIC Lab" FontSize="26" FontWeight="SemiBold"/><Border Grid.Row="1" Background="#FFF0CA" Padding="12" Margin="0,12"><TextBlock TextWrapping="Wrap" Text="Этап W2: тестовый движок. Кнопки проверяют управление службой; VPN и маршрутизация пока не включаются."/></Border><StackPanel Grid.Row="2"><TextBlock x:Name="StateText" Text="Проверка службы…" FontSize="18" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Button x:Name="StartButton" Content="Запустить тест" Click="StartClick"/><Button x:Name="StopButton" Content="Остановить" Click="StopClick"/><Button x:Name="RefreshButton" Content="Обновить статус" Click="RefreshClick"/></StackPanel><TextBlock Text="Конфигурация выходов · JSON" Margin="0,0,0,6"/></StackPanel><TextBox Grid.Row="3" x:Name="ConfigText" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10"/><StackPanel Grid.Row="4" Margin="0,14,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="ImportButton" Content="Открыть файл…" Click="ImportClick"/><Button x:Name="ValidateButton" Content="Проверить" Click="ValidateClick"/><Button x:Name="ApplyButton" Content="Применить" Click="ApplyClick"/></StackPanel><TextBlock x:Name="MessageText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#365267"/></StackPanel></Grid></Window>