<Window x:Class="QuicLab.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="QUIC Lab · Windows Preview" Width="440" Height="470" MinWidth="390" MinHeight="470" Background="#F3F6F8" FontFamily="Segoe UI" Foreground="#183544">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
  <DockPanel Margin="0,0,0,10"><TextBlock Text="QUIC Lab" FontSize="20" FontWeight="SemiBold"/><Button x:Name="RefreshButton" Content="↻" ToolTip="Обновить статус" Click="RefreshClick" FontSize="20" Padding="6,0" Width="34" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"/></DockPanel>
  <Border Background="White" CornerRadius="10" Padding="10" BorderBrush="#DCE6EB" BorderThickness="1"><StackPanel>
   <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#8B9CA5" Margin="0,0,9,0"/><TextBlock x:Name="StateText" Text="Проверка службы…" FontSize="20" FontWeight="SemiBold"/></StackPanel>
   <TextBlock x:Name="ProfileText" Text="Подключение к службе" Margin="0,5,0,8" Foreground="#607783" TextWrapping="Wrap"/>
   <Border x:Name="ModeBanner" Margin="0,0,0,8" Visibility="Collapsed"><Expander Header="Подсети и ограничения" FontSize="12"><Border Background="#FFF2CF" CornerRadius="5" Padding="8" Margin="0,6,0,0"><TextBlock x:Name="ModeText" TextWrapping="Wrap" FontSize="12"/></Border></Expander></Border>
   <Button x:Name="ToggleButton" Content="Подключить" Click="ToggleClick" Background="#00877F" Foreground="White" BorderThickness="0" Padding="12,8" FontSize="15" HorizontalContentAlignment="Center" IsEnabled="False"/>
   <ProgressBar x:Name="BusyBar" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,0"/>
  </StackPanel></Border>
  <Border Background="White" CornerRadius="10" Padding="10" Margin="0,8,0,0" BorderBrush="#DCE6EB" BorderThickness="1"><StackPanel>
   <TextBlock Text="Трафик VPN" ToolTip="Полезные данные приложений; служебный трафик туннеля не учитывается." FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Grid.Column="1" Text="↑ TX" Foreground="#647B86" FontSize="12"/><TextBlock Grid.Column="2" Text="↓ RX" Foreground="#647B86" FontSize="12"/>
    <TextBlock Grid.Row="1" Text="Всего" VerticalAlignment="Center" FontSize="12" Foreground="#647B86"/>
    <TextBlock x:Name="TxTotalText" Grid.Row="1" Grid.Column="1" Text="—" FontSize="20" Margin="0,3,0,4"/><TextBlock x:Name="RxTotalText" Grid.Row="1" Grid.Column="2" Text="—" FontSize="20" Margin="0,3,0,4"/>
    <TextBlock Grid.Row="2" Text="Сейчас" VerticalAlignment="Center" FontSize="12" Foreground="#647B86"/>
    <TextBlock x:Name="TxRateText" Grid.Row="2" Grid.Column="1" Text="—" FontSize="16"/><TextBlock x:Name="RxRateText" Grid.Row="2" Grid.Column="2" Text="—" FontSize="16"/>
   </Grid><TextBlock x:Name="TrafficHintText" Text="Счётчики ещё не получены" FontSize="11" Foreground="#647B86" Margin="0,8,0,0" TextWrapping="Wrap"/>
  </StackPanel></Border>
  <TextBlock x:Name="MessageText" Margin="2,6,2,4" FontSize="12" Foreground="#607783" TextWrapping="Wrap"/>
  <Button Visibility="Collapsed" x:Name="ApplicationsButton" Content="Приложения · подготовить список…" Click="ApplicationsClick" Padding="10,7" HorizontalAlignment="Left" Margin="0,4,0,8"/>
  <Expander x:Name="SettingsPanel" Header="Настройки подключения" Margin="0,5,0,0"><StackPanel Margin="0,8,0,0">
   <TextBlock Text="Конфигурация службы · JSON" Margin="0,0,0,6"/>
   <TextBlock Text="В MVP рабочий профиль задаётся администратором в engine.json. JSON ниже применяется только к тестовому движку. Импорт профилей в обычной форме появится следующим этапом." TextWrapping="Wrap" FontSize="11" Foreground="#607783" Margin="0,0,0,8"/>
   <TextBox x:Name="ConfigText" Height="180" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8"/>
   <WrapPanel Margin="0,8,0,0"><Button x:Name="ImportButton" Content="Открыть…" Click="ImportClick"/><Button x:Name="ValidateButton" Content="Проверить" Click="ValidateClick"/><Button x:Name="ApplyButton" Content="Применить" Click="ApplyClick"/></WrapPanel>
  </StackPanel></Expander>

 </StackPanel></ScrollViewer>
</Window>
