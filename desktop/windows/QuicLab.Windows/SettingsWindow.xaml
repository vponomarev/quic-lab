<Window x:Class="QuicLab.Windows.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Настройки VPN" Width="680" Height="690" MinWidth="520" MinHeight="480" Background="#F3F6F8" Foreground="#183544" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
 <Window.Resources><Style TargetType="TextBox"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,3,0,8"/></Style><Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/></Style></Window.Resources>
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><TextBlock x:Name="Feedback" TextWrapping="Wrap" Margin="0,0,0,8"/><ProgressBar x:Name="Progress" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,0,0,8"/><WrapPanel><Button x:Name="SaveButton" Content="Сохранить" Click="SaveClick" Background="#00877F" Foreground="White" BorderThickness="0" IsEnabled="False"/><Button x:Name="CheckButton" Content="Проверить" Click="CheckClick" IsEnabled="False"/><Button Content="Закрыть" Click="CloseClick"/></WrapPanel></StackPanel>
  <TabControl x:Name="Tabs">
   <TabItem Header="Подключение"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
    <TextBlock Text="Название"/><TextBox x:Name="NameBox" MaxLength="128"/>
    <TextBlock Text="Транспорт"/><ComboBox x:Name="TransportBox" SelectedIndex="0" Margin="0,3,0,10" Padding="5"><ComboBoxItem Content="QUIC" Tag="quic"/><ComboBoxItem Content="HTTPS" Tag="https"/></ComboBox>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Адрес сервера (IPv4)"/><TextBox x:Name="HostBox"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Порт"/><TextBox x:Name="PortBox"/></StackPanel></Grid>
    <TextBlock Text="Имя сервера"/><TextBox x:Name="HostnameBox"/>
    <TextBlock Text="Сертификат клиента (PEM)"/><TextBox x:Name="CertificateBox" Height="68" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><Button Content="Открыть сертификат…" Tag="certificate" Click="FileClick" HorizontalAlignment="Left"/>
    <CheckBox x:Name="ReplaceKeyBox" Content="Заменить приватный ключ" Margin="0,12,0,3"/><TextBlock x:Name="KeyHint" FontSize="11" Foreground="#607783"/><PasswordBox x:Name="KeyBox" Padding="6" Margin="0,4,0,6"/><Button Content="Открыть ключ…" Tag="key" Click="FileClick" HorizontalAlignment="Left"/>
    <Expander Header="Дополнительные настройки" Margin="0,14,0,0"><StackPanel Margin="0,8,0,0">
     <TextBlock Text="Физический сетевой адаптер"/><ComboBox x:Name="InterfaceBox" DisplayMemberPath="Name" SelectedValuePath="Index" Margin="0,4,0,10" Padding="5"/>
     <TextBlock Text="TLS SNI"/><TextBox x:Name="ServerNameBox"/><TextBlock Text="Имя для проверки сертификата"/><TextBox x:Name="VerifyNameBox"/>
     <TextBlock Text="CA (необязательно, пусто — системное доверие)"/><TextBox x:Name="CABox" Height="68" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><Button Content="Открыть CA…" Tag="ca" Click="FileClick" HorizontalAlignment="Left"/>
    </StackPanel></Expander>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Подсети"><DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="Через VPN — только указанные IPv4-подсети (до 256)." TextWrapping="Wrap"/><TextBlock Text="Системный DNS не меняется. IPv6 и маршрут 0.0.0.0/0 пока не поддерживаются." FontSize="11" Foreground="#607783" TextWrapping="Wrap" Margin="0,5,0,10"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><TextBlock Text="Добавить CIDR — по одному на строку или через запятую"/><TextBox x:Name="RouteInput" Height="65" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><WrapPanel><Button Content="Добавить" Click="AddRoutesClick"/><Button Content="Удалить выбранные" Click="RemoveRoutesClick"/></WrapPanel><TextBlock x:Name="RouteCount" Margin="0,8,0,0"/></StackPanel>
    <DataGrid x:Name="RouteGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" HeadersVisibility="Column" RowHeight="30"><DataGrid.Columns><DataGridTextColumn Header="Подсеть / CIDR" Binding="{Binding Cidr, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid>
   </DockPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
