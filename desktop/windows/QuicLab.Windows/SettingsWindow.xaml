<Window x:Class="QuicLab.Windows.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Настройки VPN" Width="680" Height="690" MinWidth="520" MinHeight="480" Background="#F3F6F8" Foreground="#183544" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
 <Window.Resources><Style TargetType="TextBox"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,3,0,8"/></Style><Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/></Style></Window.Resources>
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><TextBlock x:Name="Feedback" TextWrapping="Wrap" Margin="0,0,0,8"/><ProgressBar x:Name="Progress" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,0,0,8"/><WrapPanel><Button x:Name="SaveButton" Content="Сохранить" Click="SaveClick" Background="#00877F" Foreground="White" BorderThickness="0" IsEnabled="False"/><Button x:Name="CheckButton" Content="Проверить" Click="CheckClick" IsEnabled="False"/><Button x:Name="CancelDownloadButton" Content="Отменить загрузку" Click="CancelDownloadClick" Visibility="Collapsed"/><Button Content="Закрыть" Click="CloseClick"/></WrapPanel></StackPanel>
  <TabControl x:Name="Tabs">
   <TabItem x:Name="ProfilesTab" Header="Профили"><DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="ProfileLibraryHint" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock x:Name="ProfileCount" Margin="0,0,0,8"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
     <WrapPanel Margin="0,0,0,8"><Button x:Name="ActivateProfileButton" Content="Выбрать профиль" Click="ActivateProfileClick" IsEnabled="False"/><Button x:Name="DeleteProfileButton" Content="Удалить" Click="DeleteProfileClick" IsEnabled="False"/></WrapPanel>
     <TextBlock Text="Параметры из вкладки «Подключение»" Margin="0,8,0,8"/>
     <WrapPanel><Button x:Name="SaveNewProfileButton" Content="Сохранить как новый" Click="SaveNewProfileClick" IsEnabled="False"/><Button x:Name="ReplaceProfileButton" Content="Заменить выбранный" Click="ReplaceProfileClick" IsEnabled="False"/></WrapPanel>
     <TextBlock Text="Сохранение в библиотеку не меняет работающий VPN. При выборе другого профиля работающий VPN переподключается. Удаление снимка не удаляет уже выбранные параметры подключения." TextWrapping="Wrap" Foreground="#607783" Margin="0,12,0,0"/>
    </StackPanel>
    <ListBox x:Name="SavedProfilesList" DisplayMemberPath="Label" SelectionChanged="ProfileSelectionChanged" Padding="6"/>
   </DockPanel></TabItem>
   <TabItem Header="Подключение" IsSelected="True"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
    <Expander Header="Загрузить параметры по URL" IsExpanded="True" Margin="0,0,0,12"><StackPanel Margin="0,6,0,0">
    <TextBlock Text="HTTPS-ссылка на профиль или приглашение QUIC Lab" TextWrapping="Wrap"/><TextBox x:Name="UrlBox" MaxLength="8192"/>
    <Button x:Name="LoadUrlButton" Content="Загрузить" Click="LoadUrlClick" HorizontalAlignment="Left"/>
    <TextBlock Text="Приглашение регистрирует устройство при загрузке. Подсети и адаптер сохраняются; VPN изменится только после сохранения." TextWrapping="Wrap" FontSize="11" Foreground="#607783" Margin="0,6,0,0"/>
    <StackPanel x:Name="DownloadedTransportPanel" Visibility="Collapsed" Margin="0,8,0,0"><TextBlock Text="Транспорт из загруженного профиля"/><ComboBox x:Name="DownloadedTransportBox" DisplayMemberPath="Transport" SelectionChanged="DownloadedTransportChanged" Padding="5"/></StackPanel>
    </StackPanel></Expander>
    <TextBlock Text="Название"/><TextBox x:Name="NameBox" MaxLength="128"/>
    <TextBlock Text="Транспорт"/><ComboBox x:Name="TransportBox" SelectedIndex="0" SelectionChanged="TransportChanged" Margin="0,3,0,10" Padding="5"><ComboBoxItem Content="QUIC" Tag="quic"/><ComboBoxItem Content="HTTPS" Tag="https"/><ComboBoxItem Content="AmneziaWG" Tag="awg"/><ComboBoxItem Content="VLESS" Tag="vless"/></ComboBox>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Адрес сервера (IPv4 или имя)"/><TextBox x:Name="HostBox"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Порт"/><TextBox x:Name="PortBox"/></StackPanel></Grid>
    <StackPanel x:Name="QuicFields"><TextBlock Text="Имя сервера"/><TextBox x:Name="HostnameBox"/>
    <TextBlock Text="Сертификат клиента (PEM)"/><TextBox x:Name="CertificateBox" Height="68" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><Button Content="Открыть сертификат…" Tag="certificate" Click="FileClick" HorizontalAlignment="Left"/>
    </StackPanel>
    <StackPanel x:Name="ImportFields" Visibility="Collapsed" Margin="0,8,0,0"><TextBlock Text="Импорт AWG .conf или VLESS ссылки" FontWeight="SemiBold"/><TextBlock Text="Вставьте профиль в поле ниже или откройте файл. После проверки адрес заполнится автоматически. Ключи хранятся в службе и не читаются обратно." TextWrapping="Wrap" FontSize="11" Margin="0,5,0,8"/><Button Content="Проверить и разобрать профиль" Click="PreviewImportClick" HorizontalAlignment="Left"/><TextBlock x:Name="ImportHint" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
    <CheckBox x:Name="ReplaceKeyBox" Content="Заменить ключ / импортированный профиль" Margin="0,12,0,3"/><TextBlock x:Name="KeyHint" FontSize="11" Foreground="#607783"/><PasswordBox x:Name="KeyBox" Padding="6" Margin="0,4,0,6"/><Button Content="Открыть ключ / профиль…" Tag="key" Click="FileClick" HorizontalAlignment="Left"/>
    <Expander Header="Дополнительные настройки" Margin="0,14,0,0"><StackPanel Margin="0,8,0,0">
     <CheckBox x:Name="AutoUplinkBox" Content="Выбирать сеть автоматически (Wi-Fi / LTE)" Checked="RoutingChanged" Unchecked="RoutingChanged" Margin="0,0,0,8"/><TextBlock Text="Физический сетевой адаптер"/><ComboBox x:Name="InterfaceBox" DisplayMemberPath="Name" SelectedValuePath="Index" Margin="0,4,0,10" Padding="5"/>
     <StackPanel x:Name="TlsFields"><TextBlock Text="TLS SNI"/><TextBox x:Name="ServerNameBox"/><TextBlock Text="Имя для проверки сертификата"/><TextBox x:Name="VerifyNameBox"/>
     </StackPanel><StackPanel x:Name="CaFields"><TextBlock Text="CA (необязательно, пусто — системное доверие)"/><TextBox x:Name="CABox" Height="68" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><Button Content="Открыть CA…" Tag="ca" Click="FileClick" HorizontalAlignment="Left"/>
    </StackPanel></StackPanel></Expander>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Маршрутизация"><DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="Что отправлять через VPN"/><ComboBox x:Name="RoutingModeBox" SelectedIndex="1" SelectionChanged="RoutingChanged" Padding="5" Margin="0,4,0,8"><ComboBoxItem Content="Весь IPv4-трафик"/><ComboBoxItem Content="Только выбранные подсети"/></ComboBox><TextBlock Text="Локальные сети и существующие специальные маршруты сохраняются. IPv6 не изменяется. Без kill switch: при остановке туннеля трафик может идти напрямую." FontSize="11" Foreground="#607783" TextWrapping="Wrap" Margin="0,0,0,8"/><StackPanel x:Name="DnsPanel" Visibility="Collapsed"><TextBlock Text="DNS через VPN (IPv4)"/><TextBox x:Name="DnsBox" Text="1.1.1.1"/></StackPanel></StackPanel>
    <StackPanel x:Name="RouteEditPanel" DockPanel.Dock="Bottom" Margin="0,10,0,0"><TextBlock Text="Добавить CIDR — по одному на строку или через запятую"/><TextBox x:Name="RouteInput" Height="65" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><WrapPanel><Button Content="Добавить" Click="AddRoutesClick"/><Button Content="Удалить выбранные" Click="RemoveRoutesClick"/></WrapPanel><TextBlock x:Name="RouteCount" Margin="0,8,0,0"/></StackPanel>
    <DataGrid x:Name="RouteGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" HeadersVisibility="Column" RowHeight="30"><DataGrid.Columns><DataGridTextColumn Header="Подсеть / CIDR" Binding="{Binding Cidr, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid>
   </DockPanel></TabItem>
   <TabItem x:Name="ApplicationsTab" Header="Приложения"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
    <CheckBox x:Name="AppRoutingEnabled" Content="Маршрутизировать IPv4 по приложениям" Checked="AppRoutingChanged" Unchecked="AppRoutingChanged" Margin="0,0,0,12"/>
    <Button x:Name="EditApplicationsButton" Content="Режим и списки приложений…" Click="EditApplicationsClick" HorizontalAlignment="Left"/>
    <Button Content="Загрузить сохранённый черновик списков" Click="ImportApplicationDraftClick" HorizontalAlignment="Left"/>
    <TextBlock Text="Если владелец потока неизвестен или несколько владельцев требуют разных выходов" TextWrapping="Wrap" Margin="0,15,0,5"/>
    <ComboBox x:Name="UnknownAppChoice" SelectedIndex="0" SelectionChanged="AppRoutingChanged" Padding="7"><ComboBoxItem Content="Через VPN (по умолчанию)"/><ComboBoxItem Content="Напрямую"/><ComboBoxItem Content="Блокировать поток"/></ComboBox>
    <TextBlock x:Name="AppRoutingPreview" TextWrapping="Wrap" Margin="0,16,0,0"/>
    <TextBlock Text="Первые тесты движка пройдены. Приёмка захвата трафика реальных Windows-приложений и игр ещё не завершена." TextWrapping="Wrap" Foreground="#607783" Margin="0,12,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </DockPanel>
</Window>
