[Unit]
Description=QUIC Lab echo, mTLS gateway and admin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/quic-lab
StateDirectory=quic-lab
StateDirectoryMode=0700
UMask=0077
LoadCredential=cert.pem:/etc/letsencrypt/live/quic.example.org/fullchain.pem
LoadCredential=key.pem:/etc/letsencrypt/live/quic.example.org/privkey.pem
LoadCredential=admin.json:/etc/quic-lab/admin.json
LoadCredential=server.json:/etc/quic-lab/server.json
ExecStart=/opt/quic-lab/quic-lab-server -config ${CREDENTIALS_DIRECTORY}/server.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ExecReload=/bin/kill -HUP $MAINPID

[Install]
WantedBy=multi-user.target
